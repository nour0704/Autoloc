              "raw": "{{baseUrl}}/api/contrats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contrats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Créer un contrat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dateSignature\": \"2026-11-02\",\n  \"montantTotal\": 480.00,\n  \"valide\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/contrats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "contrats"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"contratId\", jsonData.idContrat || jsonData.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
